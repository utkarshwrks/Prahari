# Set these in the Render service (or via render.yaml). All are optional;
# the engine boots with none of them.
ENVIRONMENT=production
CORS_ORIGINS=*
RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
# Anchoring (optional): only if you want on-chain seals from the deployed engine.
# Paste the funded testnet key here in Render — never commit it.
# ANCHOR_PRIVATE_KEY=0x...
