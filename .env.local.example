# =============================================================
# PRAHARI — environment configuration (ALL OPTIONAL)
# The core app runs with `npm install && npm run dev` and NO env vars.
# Copy this file to `.env.local` to customise.
# =============================================================

# ---- Live NER (optional) -------------------------------------
# Enables the LIVE NER ANALYZER to use Groq instead of the built-in
# local extractor. Server-side only (NOT prefixed NEXT_PUBLIC) so the
# key never reaches the browser. Get a free key: https://console.groq.com/keys
# Without it, the analyzer falls back to a local engine and everything runs at $0.
GROQ_API_KEY=

# Optional Groq model override. Groq retires models periodically; the app
# defaults to openai/gpt-oss-120b. Set this if that id ever 404s.
GROQ_MODEL=

# ---- Auth (optional) -----------------------------------------
# NextAuth session-signing secret. A safe default is baked in for local dev,
# so this is only needed for a real deployment. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
