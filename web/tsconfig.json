{
  "compilerOptions": {
    // Explicit. With no target, tsc defaults to ES5 and rejects `matchAll`,
    // Set/iterator spread and the `u`/`s` regex flags -- so `npx tsc --noEmit`
    // disagreed with `next build`, which supplies its own. Type checking only:
    // noEmit is on and Next compiles with SWC, so this changes no output.
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
