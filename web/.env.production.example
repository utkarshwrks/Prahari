# Server-side env for the deployed web service (Render dashboard, or Vercel
# Settings -> Environment Variables). The browser NEVER sees ENGINE_URL — the
# server-side proxy at app/api/engine/[...path] is the only reader.
#
# This MUST be the live v2 engine. The old v1 host `prahari-engine.onrender.com`
# is SUSPENDED: it answers every request with an HTML "service has been
# suspended" page, which the workbench can only report as an unreachable engine.
ENGINE_URL=https://prahari-v2-engine.onrender.com
# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
NEXTAUTH_URL=https://prahari-v2-web.onrender.com
